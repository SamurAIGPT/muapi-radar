# =====================================================================
#  Muapi Radar — Environment Variables
#  Copy this file to `.env.local` and fill in what you need.
#  Works with zero configuration out of the box (embedded PGlite database).
# =====================================================================

# --- Core Database & Security ---
# Optional in development: leave empty to use embedded PGlite in `.data/pglite`.
# In production, provide a Postgres connection URI (e.g. Neon Serverless).
DATABASE_URL=

# Secret used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=dev-secret-change-in-production

# Public URL of the app
APP_URL=http://localhost:3000

# Default administrator account (created on first run if DB is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

# --- White-label Branding ---
NEXT_PUBLIC_BRAND_NAME=Muapi Radar
NEXT_PUBLIC_BRAND_BYLINE=Autonomous Media Intelligence & Social Listening

# --- Muapi APIs (Commercial Retrieval) ---
# Powers commercial social search (X, Reddit, TikTok, IG, YT, LinkedIn),
# news retrieval, search interest (Google Trends), and unified reviews (Google, App Store, Yelp).
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.com

# --- AI Engines (BYOK Post-Ingestion Analytics) ---
# Powers sentiment, emotion, narrative clustering, daily briefs, and AI query builder.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=

# Hard monthly spend cap for AI API calls in USD
API_BUDGET_USD=25

# --- Telegram Push Notifications (Optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- MCP Server Security ---
# Bearer token protecting the `/api/mcp` streamable endpoint for Claude / Copilot
RADAR_MCP_TOKEN=

# Protects `/api/cron/daily` endpoint
CRON_SECRET=

# --- Direct Open-Source Connectors (Optional Free Keys) ---
# GitHub personal access token (raises rate limits from 60 to 5000/hr)
GITHUB_TOKEN=
# Discord Bot Token (for server watchlist ingestion)
DISCORD_BOT_TOKEN=
# Podcast Index API credentials (free at https://podcastindex.org)
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
# Football-Data.org API Token (free tier)
FOOTBALL_DATA_API_KEY=
# Alpha Vantage API Key (free tier for stock prices)
ALPHAVANTAGE_API_KEY=
